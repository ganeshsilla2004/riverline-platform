MONGO_URL=mongodb://mongo:27017
REDIS_HOST=redis
REDIS_PORT=6379

PORT=3000

# 32-byte hex secret used to AES-GCM-wrap per-tenant tokenization keys at rest.
# Rotate by re-wrapping each tenant_keys row.
PLATFORM_KEY=11111111111111111111111111111111111111111111111111111111111111111

# JWT signing secret for HS256. 1h token expiry.
JWT_SECRET=dev-only-jwt-secret-change-in-prod

# HMAC secret used to authenticate payment-gateway webhook bodies.
WEBHOOK_SECRET=dev-only-webhook-secret

# Default password applied to every seed user during migration.
# Test only. Real systems would force a password reset on first login.
SEED_USER_PASSWORD=password123
