{
  "name": "riverline-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant data platform for debt collection — Riverline backend assessment",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/migration/seed.ts",
    "migrate:reverse": "tsx src/migration/reverse.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "bullmq": "5.12.0",
    "express": "4.19.2",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.3"
  }
}
